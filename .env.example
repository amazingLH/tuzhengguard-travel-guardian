# Copy this file to .env for local development.
# Never commit real values.
DASHSCOPE_API_KEY=
FLYAI_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_AGENT_ID=
BAILIAN_ENVIRONMENT_ID=
DASHSCOPE_TEXT_MODEL=qwen3.7-flash
DASHSCOPE_VISION_MODEL=qwen3.7-flash
# Daily visitor policy is fixed at 100 per category; no global daily cap.
TRIPTWIN_BROWSER_STATE_SECRET=
TRIPTWIN_RATE_LIMIT_SALT=
# Optional durable/writable path; defaults to the operating-system temp folder.
TRIPTWIN_USAGE_COUNTER_PATH=

